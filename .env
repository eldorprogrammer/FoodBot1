# Токен бота, полученный от @BotFather
BOT_TOKEN=8835274939:AAFSP2e3Rwp0Nqtr-ZCG1NRoHDACvCd7Jeg

# Провайдерский токен для приёма онлайн-оплаты (Telegram Payments)
# Получается у платёжного провайдера, подключённого через @BotFather -> Payments
# Если не заполнять, кнопка "Оплата онлайн" будет недоступна
PAYMENTS_PROVIDER_TOKEN=

# Строка подключения к базе данных.
# По умолчанию — SQLite: отдельный сервер БД не нужен, файл foodbot.db
# создастся автоматически в папке проекта при первом запуске.
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_dipBZ73vXqPC@ep-mute-firefly-ax4l6epi.c-4.us-east-2.aws.neon.tech/neondb

# Если используете внешнюю PostgreSQL (например, Neon, Supabase, свой сервер)
# укажите её строку подключения, предварительно заменив postgres:// на
# postgresql+asyncpg:// (и sslmode=require на ssl=require для Neon):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Telegram ID администраторов через запятую (узнать свой id можно у @userinfobot)
# Необязательно: такие пользователи получают доступ к админке автоматически,
# без ввода логина и пароля.
ADMIN_IDS=8271399406,8433848963

# Логин и пароль для входа в админ-панель через кнопку "🔐 Админ-панель"
# в главном меню (доступна любому посетителю бота)
ADMIN_LOGIN=AL_Hayot_2002
ADMIN_PASSWORD=Hayot2002

# Название заведения, отображается в старте/чеках
RESTAURANT_NAME=AL Hayot
